<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorF3F6FD"
    tools:context=".logic.demo.controller.HiDemoActivity">
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/colorF3F6FD"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:id="@+id/navigationRl">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent = "true"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/ylzColorTitleOne"
            android:text = "福建八闽健康码" />
        <RelativeLayout
            android:id="@+id/midLl"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:background="@drawable/btn_radius">
            <Button
                android:id="@+id/more"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="10dp"
                android:background="@mipmap/ylz_mirco_more"/>
            <View
                android:layout_width="0.5dp"
                android:layout_height="16dp"
                android:background="@color/ylzColorTitleThree"
                android:layout_centerInParent = "true"
                />
            <Button
                android:id="@+id/shut"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:background="@mipmap/ylz_mirco_shut"/>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:id="@+id/bannner"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navigationRl"
        android:layout_marginLeft = "16dp"
        android:layout_marginRight = "16dp"
        android:layout_marginTop = "16dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/btn_radius_18_red"/>

    <TextView
        android:id="@+id/bannerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/bannner"
        app:layout_constraintBottom_toBottomOf="@id/bannner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:text = " Banner Loop " />

    <RelativeLayout
    android:id="@+id/carouselLayout"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toBottomOf="@id/bannner"
    android:layout_marginLeft = "16dp"
    android:layout_marginRight = "16dp"
    android:layout_marginTop = "8dp"
    android:layout_width="match_parent"
    android:layout_height="60dp">
        <ImageView
            android:id="@+id/carouselContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"
            android:background="@drawable/btn_radius_18_blue" />
        <TextView
            android:id="@+id/carouselTitleContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/appWhite"
            android:text = "Carousel" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/carouselConst"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/carouselLayout"
        android:layout_marginLeft = "16dp"
        android:layout_marginRight = "16dp"
        android:layout_marginTop = "8dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/btn_radius_18_red" />
    <TextView
        android:id="@+id/carouselTitleConst"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/carouselConst"
        app:layout_constraintBottom_toBottomOf="@id/carouselConst"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/appWhite"
        android:text = "Carousel" />

    <LinearLayout
        android:id="@+id/btnGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/carouselConst"
        android:layout_marginLeft = "16dp"
        android:layout_marginRight = "16dp"
        android:layout_marginTop = "8dp">

        <RelativeLayout
            android:id="@+id/fastBtn"
            android:layout_weight="1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:clipChildren="true"
            android:background="@drawable/btn_radius_10_white">
            <ImageView
                android:id="@+id/codeImageView"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentLeft="true"
                android:background="@drawable/btn_radius_8_909fb8" />

            <Button
                android:id="@+id/recommandBtn"
                android:layout_width="48dp"
                android:layout_height="24dp"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:layout_alignParentLeft="true"
                android:layout_below="@id/codeImageView"
                android:background="@drawable/btn_radius_15_blue"
                android:text="推荐"
                android:textColor="@color/YLZColorMZTBlueView" />

            <Button
                android:id="@+id/restBtn"
                android:layout_width="64dp"
                android:layout_height="24dp"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="8dp"
                android:layout_alignTop="@id/recommandBtn"
                android:layout_toRightOf="@id/recommandBtn"
                android:layout_below="@id/codeImageView"
                android:background="@drawable/btn_radius_15_gold"
                android:text="库存999"
                android:textColor="@color/YLZColorMZTGoldView"/>

            <TextView
                android:id="@+id/shopTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:layout_below="@id/recommandBtn"
                android:textStyle="normal"
                android:textSize="14sp"
                android:ellipsize="end"
                android:singleLine="false"
                android:textColor="@color/ylzColorTitleOne"
                android:text = "福建八闽健康码福建八闽健康码福建八闽健康码" />

            <LinearLayout
                android:id="@+id/botGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:layout_below="@id/shopTitle"
                android:layout_gravity="center_vertical">
                <TextView
                    android:id="@+id/priceTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:gravity="start"
                    android:textColor="@color/appOrange"
                    android:text = "$48.0" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                />

                <TextView
                    android:id="@+id/saleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginRight="8dp"
                    android:textStyle="normal"
                    android:textSize="12sp"
                    android:gravity="center_vertical"
                    android:textColor="@color/ylzColorTitleOne"
                    android:text = "销量：120" />

            </LinearLayout>

        </RelativeLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/vaccineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="@drawable/btn_radius_10_white">

            <ImageView
                android:id="@+id/scanImageView"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/btn_radius_18_blue" />

            <Button
                android:id="@+id/scanBtn"
                android:layout_width="48dp"
                android:layout_height="24dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scanImageView"
                android:background="@drawable/btn_radius_15_blue"
                android:text="推荐"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/YLZColorMZTBlueView" />

            <Button
                android:id="@+id/paddingButton"
                android:layout_width="64dp"
                android:layout_height="24dp"
                app:layout_constraintLeft_toRightOf="@id/scanBtn"
                app:layout_constraintTop_toTopOf="@id/scanBtn"
                android:layout_marginLeft="8dp"
                android:background="@drawable/btn_radius_15_gold"
                android:text="库存999"
                android:textColor="@color/YLZColorMZTGoldView"/>

            <TextView
                android:id="@+id/nameTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/scanBtn"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf = "parent"
                android:layout_marginTop="8dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:textStyle="normal"
                android:textSize="14sp"
                android:ellipsize="end"
                android:singleLine="false"
                android:textColor="@color/ylzColorTitleOne"
                android:text = "福建八闽健康码福建八闽健康码福建八闽健康码" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/botLayout"
                app:layout_constraintTop_toBottomOf="@id/nameTitle"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_below="@id/nameTitle">
                <TextView
                    android:id="@+id/priceTitleConst"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginLeft="8dp"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_weight="1"
                    android:textColor="@color/appOrange"
                    android:text = "$48.0" />

                <TextView
                    android:id="@+id/saleTitleConst"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    app:layout_constraintRight_toRightOf="parent"
                    android:textStyle="normal"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textColor="@color/ylzColorTitleOne"
                    android:text = "销量：120" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/testLinear"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnGroup"
        android:layout_marginLeft = "16dp"
        android:layout_marginRight = "16dp"
        android:background="@color/colorAccent"
        android:layout_marginTop = "8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <View
            android:id="@+id/testLeftLinear"
            android:layout_marginLeft = "16dp"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:background="@color/YLZColorMZTGreenView"/>
<!--        <View-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="0dp"-->
<!--            android:layout_weight="1"/>-->

        <TextView
            android:id="@+id/titleLinear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="@color/appWhite"
            android:layout_weight="1"
            android:text = "Title" />

        <View
            android:id="@+id/testRightLinear"
            android:layout_marginRight = "16dp"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:background="@color/YLZColorMZTOrangeView"/>

    </LinearLayout>

    <RelativeLayout
    android:id="@+id/testRela"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toBottomOf="@id/testLinear"
    android:layout_marginLeft = "16dp"
    android:layout_marginRight = "16dp"
    android:layout_marginTop = "8dp"
    android:layout_width="match_parent"
    android:background="@color/YLZColorMZTGradientThreeView"
    android:layout_height="60dp">
        <View
            android:id="@+id/testLeftRela"
            android:layout_marginLeft = "16dp"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:background="@color/YLZColorMZTGreenView"/>

        <TextView
            android:id="@+id/titleRela"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/appWhite"
            android:text = "Title" />

        <View
            android:id="@+id/testRightRela"
            android:layout_marginRight = "16dp"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:layout_alignParentRight="true"
            android:background="@color/YLZColorMZTOrangeView"/>

    </RelativeLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/testConst"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/testRela"
        android:layout_marginLeft = "16dp"
        android:layout_marginRight = "16dp"
        android:layout_marginTop = "8dp"
        android:layout_width="match_parent"
        android:background="@color/purple_200"
        android:layout_height="60dp">
        <View
            android:id="@+id/testLeftConst"
            android:layout_marginLeft = "16dp"
            android:layout_width="100dp"
            android:layout_height="48dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/YLZColorMZTGreenView"/>

        <TextView
            android:id="@+id/titleConst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/appWhite"
            android:text = "Title" />

        <View
            android:id="@+id/testRightConst"
            android:layout_marginRight = "16dp"
            android:layout_width="100dp"
            android:layout_height="48dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/YLZColorMZTOrangeView"/>

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
  猜你想办白卡
  顶部32dp蓝色垫底(与头部渐变末色一致):白卡压在垫底上,还原"上浮压住蓝色头部"的悬浮效果
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:background="@drawable/bg_hi_header_end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_hi_card_white"
        android:elevation="3dp"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="12dp">

        <LinearLayout
            android:id="@+id/moreGuess"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="猜你"
                android:textColor="#14182B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="想办"
                android:textColor="#FF8C1A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更多"
                android:textColor="#6B7686"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/ic_service_arrow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/guessItem1"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_hi_dot_active" />

            <TextView
                android:id="@+id/guessItem1Tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:textColor="#22283A"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_service_arrow" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:layout_marginLeft="18dp"
            android:background="#F2F3F7" />

        <LinearLayout
            android:id="@+id/guessItem2"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_hi_dot_active" />

            <TextView
                android:id="@+id/guessItem2Tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:textColor="#22283A"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_service_arrow" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

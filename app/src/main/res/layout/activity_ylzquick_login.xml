<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_quick_login_top"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:windowSoftInputMode="adjustPan"
    tools:context=".logic.login.YLZQuickLoginActivity">

    <include
        layout="@layout/toolbar_customer_imr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!--顶部右侧3D卡片装饰(纯XML占位,后续可替换为设计切图)-->
    <FrameLayout
        android:id="@+id/cardDecorFl"
        android:layout_width="118dp"
        android:layout_height="112dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="6dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--玻璃卡片底层-->
        <View
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:alpha="0.9"
            android:background="@drawable/bg_quick_login_glass"
            android:rotation="24" />

        <!--玻璃卡片面层-->
        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_quick_login_glass"
            android:rotation="14">

            <!--红色徽标-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_quick_login_badge_red"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingTop="7dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="龍岩"
                    android:textColor="@color/appWhite"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.8dp"
                    android:layout_marginTop="3dp"
                    android:background="#80FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="一卡通"
                    android:textColor="@color/appWhite"
                    android:textSize="7sp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/titleHiTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="16dp"
        android:text="您好，"
        android:textColor="@color/ylzQuickLoginBlue"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolBarRL" />

    <TextView
        android:id="@+id/titleWelcomeTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="6dp"
        android:text="欢迎使用龙岩一卡通"
        android:textColor="@color/ylzColorTitleOne"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleHiTv" />

    <!--登录方式卡片-->
    <LinearLayout
        android:id="@+id/cardLl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_quick_login_card"
        android:orientation="vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleWelcomeTv">

        <!--个人登录/单位登录选项卡-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabPersonalLl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_login_tab_left"
                android:clickable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabPersonalTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="个人登录"
                    android:textColor="@color/ylzColorTitleOne"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/tabPersonalIndicator"
                    android:layout_width="30dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_quick_login_tab_indicator" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabUnitLl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_login_tab_right"
                android:clickable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabUnitTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:text="单位登录"
                    android:textColor="@color/ylzColorTitleThree"
                    android:textSize="19sp" />

                <View
                    android:id="@+id/tabUnitIndicator"
                    android:layout_width="30dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_quick_login_tab_indicator"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!--表单区域-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="22dp">

            <!--手机号-->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_quick_login_input">

                <ImageView
                    android:id="@+id/phoneImv"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="14dp"
                    app:srcCompat="@drawable/ic_quick_login_phone" />

                <EditText
                    android:id="@+id/phoneEt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="44dp"
                    android:layout_marginRight="14dp"
                    android:background="@null"
                    android:hint="请输入手机号"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:singleLine="true"
                    android:textColor="@color/ylzColorTitleOne"
                    android:textColorHint="@color/ylzQuickLoginHint"
                    android:textCursorDrawable="@drawable/color_cursor"
                    android:textSize="16sp" />
            </FrameLayout>

            <!--短信验证码-->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_quick_login_input">

                <ImageView
                    android:id="@+id/smsImv"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="14dp"
                    app:srcCompat="@drawable/ic_quick_login_sms" />

                <EditText
                    android:id="@+id/smsEt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="44dp"
                    android:layout_marginRight="92dp"
                    android:background="@null"
                    android:hint="请输入短信验证码"
                    android:inputType="number"
                    android:maxLength="6"
                    android:singleLine="true"
                    android:textColor="@color/ylzColorTitleOne"
                    android:textColorHint="@color/ylzQuickLoginHint"
                    android:textCursorDrawable="@drawable/color_cursor"
                    android:textSize="16sp" />

                <com.example.androidproject.base.view.YLZTimerButton
                    android:id="@+id/smsBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|right"
                    android:layout_marginRight="12dp"
                    android:background="@android:color/transparent"
                    android:minWidth="0dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:textColor="@color/ylzQuickLoginBlue"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!--登录按钮-->
    <Button
        android:id="@+id/loginBtn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_quick_login_btn"
        android:text="登录"
        android:textColor="@color/appWhite"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardLl" />

    <!--其他登录方式-->
    <LinearLayout
        android:id="@+id/bottomLl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.androidproject.base.view.YLZDashLineView
                android:layout_width="56dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:text="其他登录方式"
                android:textColor="@color/ylzColorTitleThree"
                android:textSize="14sp" />

            <com.example.androidproject.base.view.YLZDashLineView
                android:layout_width="56dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/mztImv"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ylz_mzt_logo_blue"
            app:riv_oval="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="闽政通"
            android:textColor="@color/ylzColorTitleTwo"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--龙岩一卡通横幅+指示圆点-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/bannerBox"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="13dp"
        android:background="@drawable/bg_hi_banner">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="龙岩一卡通"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.3"
                android:text="政务服务平台"
                android:textColor="#EBF2FF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="88dp"
            android:layout_height="80dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="52dp"
            android:src="@drawable/ic_hi_banner_phone" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="8dp"
            android:src="@drawable/ic_hi_avatar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="4dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_hi_pill_blue"
            android:paddingLeft="7dp"
            android:paddingTop="1dp"
            android:paddingRight="7dp"
            android:paddingBottom="2dp"
            android:text="龙小保"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />
    </RelativeLayout>

    <!--横幅指示圆点-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="14dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_hi_dot_active" />

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/bg_hi_dot_normal" />

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/bg_hi_dot_normal" />

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/bg_hi_dot_normal" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appWhite"
    android:orientation="vertical"
    tools:context=".logic.service.YLZServiceFragment">

    <!--头部:蓝色渐变+标题+搜索框+个人服务/单位服务选项卡-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_service_header"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="服务"
            android:textColor="@color/appWhite"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!--搜索框-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/bg_service_search"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="14dp"
                app:srcCompat="@drawable/ic_service_search" />

            <EditText
                android:id="@+id/searchEt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="14dp"
                android:background="@null"
                android:hint="请输入您想搜索的内容"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textColor="@color/ylzColorTitleOne"
                android:textColorHint="#8A97AD"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="15sp" />
        </LinearLayout>

        <!--个人服务/单位服务选项卡-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabPersonalLl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tab_left"
                android:clickable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabPersonalTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="个人服务"
                    android:textColor="@color/ylzColorTitleThree"
                    android:textSize="20sp" />

                <View
                    android:id="@+id/tabPersonalIndicator"
                    android:layout_width="34dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_quick_login_tab_indicator"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabUnitLl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_service_tab_right"
                android:clickable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabUnitTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="单位服务"
                    android:textColor="@color/ylzColorTitleOne"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/tabUnitIndicator"
                    android:layout_width="34dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_quick_login_tab_indicator" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--内容区域:左侧分类联动右侧服务列表-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cateRecyclerView"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:background="#F4F5F7"
            android:overScrollMode="never"
            android:paddingBottom="16dp"
            android:paddingTop="2dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/serviceRecyclerView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/appWhite"
            android:overScrollMode="never" />
    </LinearLayout>
</LinearLayout>
